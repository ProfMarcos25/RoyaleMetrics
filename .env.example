# ============================================================
#  .env.example — Royle Metrics
#  Template de variáveis de ambiente.
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA versione o arquivo .env com dados reais no Git!
# ============================================================

# ── API Oficial do Clash Royale ──────────────────────────────
# Obtenha seu token em: https://developer.clashroyale.com
CLASH_API_TOKEN=seu_token_aqui

# Proxy público para ambientes com IP dinâmico (escola/laboratório)
# Não altere este valor a menos que tenha IP fixo.
CLASH_API_URL=https://proxy.royaleapi.dev/v1

# ── Banco de dados PostgreSQL ────────────────────────────────
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/royale_metrics

# ── Configurações gerais ─────────────────────────────────────
# Ambiente: "development" habilita logs SQL completos
ENVIRONMENT=development

# Intervalo de coleta automática em horas (padrão: 6h)
SYNC_INTERVAL_HOURS=6
